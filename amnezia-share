    "HeaderProtectionKey", "ContentPaddingAddition", "RekeyAfterTime",
    "RekeyTimeout", "RejectAfterTime", "KeepaliveTimeout",
    "MaxHandshakeAttempts",
]

ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
SECTION_RE = re.compile(r"(?m)^\s*\[(Interface|Peer)\]\s*$")
ASSIGN_RE = re.compile(r"^\s*(?:#\s*)?([^=\s]+)\s*=\s*(.*?)\s*$")
ASSIGN_ACTIVE_RE = re.compile(r"^\s*([^#=\s][^=\s]*)\s*=\s*(.*?)\s*$")


class AmneziaShareError(RuntimeError):
    pass


def validate_mtu(value: Any) -> str:
    mtu = str(value).strip()
    if not mtu.isdecimal():
        raise AmneziaShareError(
            f"MTU must be an integer from {MIN_MTU} to {MAX_MTU}"
        )
    number = int(mtu)
    if not MIN_MTU <= number <= MAX_MTU:
        raise AmneziaShareError(
            f"MTU must be from {MIN_MTU} to {MAX_MTU}; got {mtu}"
        )
    return str(number)


def argparse_mtu(value: str) -> str:
    try:
        return validate_mtu(value)
    except AmneziaShareError as e:
        raise argparse.ArgumentTypeError(str(e)) from e


