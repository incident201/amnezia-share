CLIENTS_TABLE = "/opt/amnezia/awg/clientsTable"
SERVER_PUBLIC_KEY = "/opt/amnezia/awg/wireguard_server_public_key.key"
SERVER_PSK = "/opt/amnezia/awg/wireguard_psk.key"
AWG_INTERFACE = "awg0"

QR_MAGIC = 1984
OFFICIAL_QR_CHUNK = 850
QR_TARGET_RATIO = 0.78
QR_LEFT_PADDING = 4
# Title, frame counter, blank line above the QR, blank line below it, stop hint.
QR_LAYOUT_LINES = 5
DEFAULT_DNS1 = "1.1.1.1"
DEFAULT_DNS2 = "1.0.0.1"
DEFAULT_MTU = "1280"
MIN_MTU = 576
MAX_MTU = 65535

AWG_KEYS = [
    "Jc", "Jmin", "Jmax", "S1", "S2", "S3", "S4",
    "H1", "H2", "H3", "H4",
    "I1", "I2", "I3", "I4", "I5",
    "HeaderProtectionKey", "ContentPaddingAddition", "RekeyAfterTime",
    "RekeyTimeout", "RejectAfterTime", "KeepaliveTimeout",
